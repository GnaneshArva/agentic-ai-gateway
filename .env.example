# Application Configuration
APP_NAME=agentic-ai-gateway
APP_ENV=development
LOG_LEVEL=INFO
PORT=8007

# Downstream Services
TRAVEL_AGENT_SERVICE_URL=http://localhost:8000
OBSERVABILITY_SERVICE_URL=http://localhost:8006
GUARDRAILS_SERVICE_URL=http://localhost:8004

# Gateway Configuration
DEFAULT_ROUTE=travel-agent-service
ROUTING_STRATEGY=static
GATEWAY_TIMEOUT_SECONDS=60.0
DOWNSTREAM_TIMEOUT_SECONDS=45.0
STREAMING_TIMEOUT_SECONDS=120.0

# Rate Limiting & Quotas
RATE_LIMIT_REQUESTS_PER_MINUTE=120
DAILY_TOKEN_QUOTA=500000
MONTHLY_TOKEN_QUOTA=10000000
REQUEST_TOKEN_LIMIT=32000
DAILY_BUDGET_USD=50.0
MONTHLY_BUDGET_USD=1000.0
MAX_PAYLOAD_BYTES=10485760

# Model & Provider Whitelists
ALLOWED_MODELS=gpt-4o,gpt-4o-mini,gpt-4,gpt-3.5-turbo,claude-3-5-sonnet,claude-3-haiku,gemini-1.5-pro,gemini-1.5-flash
ALLOWED_PROVIDERS=OpenAI,Anthropic,Google,Azure OpenAI

# Resilience & Retries
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0
BACKOFF_STRATEGY=exponential
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30.0

# Feature Flags
ENABLE_ROUTING=true
ENABLE_STREAMING=true
ENABLE_RETRY=true
ENABLE_CIRCUIT_BREAKER=true
ENABLE_TELEMETRY=true
ENABLE_POLICY_ENGINE=true
ENABLE_GUARDRAILS=true
